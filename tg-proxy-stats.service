[Unit]
Description=Telegram proxy traffic statistics by client port
After=docker.service systemd-sysctl.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/sysctl -w net.netfilter.nf_conntrack_acct=1
ExecStart=/usr/bin/python3 -I -u /usr/local/bin/tg-proxy-stats --collect
Restart=on-failure
RestartSec=5s
StateDirectory=tg-proxy-stats
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
